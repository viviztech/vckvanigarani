    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,tests}/**/*.ts\" \"prisma/*.ts\"",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"prisma/*.ts\"",
