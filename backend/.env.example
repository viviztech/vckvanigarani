# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- Database (feature 001 T007-T008) ---
# Local dev uses a dedicated Postgres instance on port 5434, isolated from any
# other Postgres services already running on this machine — see README.md.
DATABASE_URL="postgresql://vanigarani:CHANGE_ME@localhost:5434/vanigarani?schema=public"

# --- Auth: email OTP + JWT (feature 001 T009-T010) ---
# EmailProvider implementation — see backend/src/modules/auth/email-provider.ts
# EMAIL_PROVIDER=mock (default) logs the OTP instead of sending it.
# EMAIL_PROVIDER=smtp sends via the SMTP_* settings below (any SMTP-speaking
# provider — SES, SendGrid, Mailgun, Gmail, ...).
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vckvanigarani.com

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- Payments (feature 002 T001) ---
# Get test-mode values from https://dashboard.razorpay.com (Settings > API Keys,
# and Settings > Webhooks for the secret) — see README.md "Razorpay test-mode setup".
# Until real keys are set, PAYMENT_PROVIDER=mock keeps Order creation/webhook
# verification fully testable without a live Razorpay account.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Notifications: push + SMS/WhatsApp (feature 002 T008) ---
# PushProvider implementation — see backend/src/common/notifications/push-provider.ts
PUSH_PROVIDER=mock
FCM_SERVICE_ACCOUNT_JSON=

# --- Receipt storage (feature 002 T009) ---
# ReceiptStorage implementation — see backend/src/modules/contributions/receipt-storage.ts
RECEIPT_STORAGE=local
RECEIPT_STORAGE_DIR=./storage/receipts
