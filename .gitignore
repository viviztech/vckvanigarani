# Scratch/build output — never committed
tmp/

# Leftover empty dir from the vanigarani/vanigarani -> top-level move
# (locked by a background process, could not be deleted yet)
vanigarani/

# public-site's own build artifacts (also covered by public-site/.gitignore,
# repeated here since this .gitignore is at the repo root)
public-site/node_modules/
public-site/dist/
public-site/.env

# backend/admin-web/mobile also carry their own .gitignore files, which
# still apply from this repo root — these are top-level-root duplicates
# for clarity
backend/node_modules/
backend/dist/
backend/generated/
backend/.env
admin-web/node_modules/
admin-web/dist/
admin-web/.env
mobile/.env
mobile/build/
mobile/.dart_tool/

*.log

# OS/editor cruft
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local agent tool state — not meant for version control
.claude/
